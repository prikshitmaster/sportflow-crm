# /ops/live dashboard PIN. Leave blank to disable the ops page entirely.
VITE_OPS_PIN=

# Shows the "Skip OTP" buttons in the /join funnel so the registration flow can
# be exercised without real SMS — including against a live deployment, which is
# why it is a build flag and not import.meta.env.DEV. Leave blank normally.
# Needs ENABLE_TRIAL_TEST_LOGIN=true on the trial-test-login edge function too;
# that is the real gate, and it must be turned off when testing ends.
VITE_ALLOW_OTP_SKIP=